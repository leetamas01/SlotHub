@model IdopontfoglaloWebalk.Models.Services

@{
    ViewData["Title"] = "Időpont foglalás - " + Model.name;
}

@Html.AntiForgeryToken()
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Search" asp-route-searchQuery="@Model.name" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Vissza a találatokhoz
        </a>
        <h1 class="fw-bold text-dark mt-2">@Model.name</h1>
        <p class="text-muted"><i class="bi bi-geo-alt-fill me-1 text-danger"></i> @Model.address</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-light mb-3">
                <h5 class="fw-bold mb-3">Foglalás menete</h5>
                <p class="small text-secondary">Válassz a naptárban egy neked megfelelő <span class="text-success fw-bold">zöld színű</span> szabad időpontot, majd kattints rá a foglalás véglegesítéséhez.</p>
                <hr />
                <div class="bg-white p-2 rounded-3 border">
                    <p class="small mb-1"><strong>Leírás:</strong></p>
                    <p class="small text-muted mb-0">@Model.description</p>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Foglalás megerősítése</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
            </div>
            <div class="modal-body py-4" id="confirmModalBody">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnConfirmBooking">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="bookingSpinner" role="status" aria-hidden="true"></span>
                    Igen, lefoglalom
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 text-center p-3">
            <div class="modal-body py-4">
                <div id="alertModalIcon" class="mb-3"></div>
                <h5 class="fw-bold mb-2" id="alertModalTitle"></h5>
                <p class="text-muted mb-0" id="alertModalMessage"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal" id="alertModalOkBtn">Rendben</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var calendarEl = document.getElementById('calendar');

        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        var confirmModal = new bootstrap.Modal(document.getElementById('bookingConfirmModal'));
        var alertModal = new bootstrap.Modal(document.getElementById('bookingAlertModal'));
        var selectedOccasionId = null;

        function showAlert(title, message, isSuccess = true, redirectUrl = null) {
            document.getElementById('alertModalTitle').innerText = title;
            document.getElementById('alertModalMessage').innerText = message;

            var iconEl = document.getElementById('alertModalIcon');
            if (isSuccess) {
                iconEl.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>';
            } else {
                iconEl.innerHTML = '<i class="bi bi-exclamation-circle-fill text-danger" style="font-size: 3rem;"></i>';
            }

            var okBtn = document.getElementById('alertModalOkBtn');
            okBtn.onclick = function() {
                alertModal.hide();
                if (redirectUrl) {
                    window.location.href = redirectUrl;
                }
            };

            alertModal.show();
        }

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'hu',
            firstDay: 1,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'timeGridWeek,timeGridDay'
            },
            buttonText: { today: 'Ma', week: 'Hét', day: 'Nap' },
            slotDuration: '00:30:00',
            slotLabelFormat: {
                hour: '2-digit',
                minute: '2-digit',
                meridiem: false,
                hour12: false
            },
            allDaySlot: false,
            slotMinTime: '07:00:00',
            slotMaxTime: '20:00:00',

            events: '/Services/GetCalendarEvents?service_id=' + @Model.service_id,

            eventClick: function(info) {
                var status = info.event.extendedProps.status;

                if (status === 'reserved') {
                    showAlert('Foglalt időpont', 'Ez az időpont sajnos már foglalt!', false);
                    return;
                }

                var isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

                if (!isAuthenticated) {
                    showAlert('Bejelentkezés szükséges', 'Az időpont lefoglalásához be kell jelentkezned!', false, '/Users/Login');
                    return;
                }

                var dateStr = info.event.start ? info.event.start.toLocaleString('hu-HU', {
                    month: 'long',
                    day: 'numeric',
                    weekday: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                }) : '';

                selectedOccasionId = info.event.id;

                document.getElementById('confirmModalBody').innerHTML = `
                    <p class="mb-1 text-muted">Biztosan le szeretnéd foglalni az alábbi időpontot?</p>
                    <h6 class="fw-bold text-dark mt-2 mb-2">${info.event.title}</h6>
                    <span class="badge bg-light text-primary border rounded-pill px-3 py-2">
                        <i class="bi bi-clock me-1"></i> ${dateStr}
                    </span>
                `;

                confirmModal.show();
            }
        });

        document.getElementById('btnConfirmBooking').addEventListener('click', function() {
            var btn = this;
            var spinner = document.getElementById('bookingSpinner');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('occasionId', selectedOccasionId);

            fetch('/Services/BookOccasion', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                confirmModal.hide();
                btn.disabled = false;
                spinner.classList.add('d-none');

                if (data && data.success) {
                    showAlert('Sikeres foglalás!', data.message, true);
                    calendar.refetchEvents();
                } else if (data && data.requireLogin) {
                    showAlert('Bejelentkezés szükséges', data.message, false, '/Users/Login');
                } else {
                    showAlert('Hiba történt', data ? data.message : 'Ismeretlen hiba.', false);
                }
            })
            .catch(err => {
                confirmModal.hide();
                btn.disabled = false;
                spinner.classList.add('d-none');
                console.error('Hiba a foglalás során:', err);
                showAlert('Hálózati hiba', 'Nem sikerült kommunikálni a szerverrel.', false);
            });
        });

        calendar.render();
    });
</script>

<style>
    .fc {
        --fc-border-color: #e9ecef;
        --fc-button-bg-color: #0d6efd;
        --fc-button-border-color: #0d6efd;
    }

        .fc .fc-toolbar-title {
            font-size: 1.4rem;
            font-weight: 700;
        }

        .fc .fc-col-header-cell-cushion {
            color: #495057;
            text-decoration: none;
            font-weight: 600;
        }
</style>