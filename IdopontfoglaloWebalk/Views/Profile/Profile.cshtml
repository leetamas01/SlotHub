@model IdopontfoglaloWebalk.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profil";
    bool isAdmin = User.IsInRole("Admin") || Model.User.UserName == "admin";
    var existingFeedbacks = ViewBag.Feedbacks as List<IdopontfoglaloWebalk.Models.Feedbacks> ?? new List<IdopontfoglaloWebalk.Models.Feedbacks>();
}

<div class="container py-5" style="max-width: 960px;">

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-primary py-4 text-center">
                    <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                        <span class="fs-1 fw-bold text-primary">@(Model.User.UserName != null ? Model.User.UserName[0].ToString().ToUpper() : "U")</span>
                    </div>
                </div>
                <div class="card-body text-center pt-0" style="margin-top: -20px;">
                    <div class="bg-white rounded-4 p-3 shadow-sm mx-2">
                        <h5 class="fw-bold mb-0">@Model.User.UserName</h5>
                        <small class="text-muted">@Model.User.Email</small>
                        @if (isAdmin)
                        {
                            <div class="mt-1">
                                <span class="badge bg-danger rounded-pill">Adminisztrátor</span>
                            </div>
                        }
                    </div>
                    <div class="mt-4 text-start px-3">
                        <p class="small mb-1 text-muted">Telefonszám</p>
                        <p class="fw-medium">@(Model.User.PhoneNumber ?? "Nincs megadva")</p>

                        <p class="small mb-1 text-muted">Értékelés</p>
                        <p class="fw-medium">
                            <i class="bi bi-star-fill text-warning"></i> @Model.User.rating.ToString("0.0")
                        </p>

                        <hr class="my-3 text-muted" />

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill"
                                    data-bs-toggle="modal" data-bs-target="#editProfileModal">
                                <i class="bi bi-pencil me-1"></i> Profil szerkesztése
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill"
                                    data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                <i class="bi bi-shield-lock me-1"></i> Jelszó módosítása
                            </button>

                            @if (!isAdmin)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill"
                                        data-bs-toggle="modal" data-bs-target="#deleteProfileModal">
                                    <i class="bi bi-trash me-1"></i> Fiók törlése
                                </button>
                            }
                            else
                            {
                                <div class="text-center py-1">
                                    <span class="badge bg-light text-muted border small">Rendszerfiók nem törölhető</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h4 class="fw-bold mb-4">Foglalásaid</h4>

            @if (!Model.Reservations.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
                    <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">Nincsenek foglalásaid</h5>
                    <p class="text-muted small mb-3">Még nem választottál időpontot egyetlen szolgáltatóhoz sem.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 align-self-center">
                        Szolgáltatások keresése
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var reservation in Model.Reservations)
                    {
                        var feedback = existingFeedbacks.FirstOrDefault(f => f.reservation_Id == reservation.reservation_id);
                        bool isPast = reservation.date < DateTime.Now;
                        var sName = reservation.ServiceCategory?.Service?.name ?? reservation.Service?.name ?? "Szolgáltatás";
                        var sAddr = reservation.ServiceCategory?.Service?.address ?? reservation.Service?.address ?? "Cím nem elérhető";
                        var cName = reservation.ServiceCategory?.Name ?? "Általános";
                        var dateText = reservation.date.ToString("yyyy. MM. dd. HH:mm");

                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">@sName</h6>
                                        @if (isPast)
                                        {
                                            <span class="badge bg-secondary rounded-pill small">Lezajlott</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill small">Közelgő</span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-tag-fill text-primary me-1"></i> @cName
                                    </p>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @sAddr
                                    </p>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        <i class="bi bi-clock me-1 text-primary"></i> @dateText
                                    </span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    @if (!isPast)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                onclick="openCancelReservationModal(@reservation.reservation_id, '@sName', '@dateText')">
                                            <i class="bi bi-x-circle me-1"></i> Lemondás
                                        </button>
                                    }
                                    else
                                    {
                                        @if (feedback != null && feedback.rating_guest > 0)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                <i class="bi bi-star-fill text-dark me-1"></i> Értékelve: @feedback.rating_guest.ToString("0.0") / 5
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm"
                                                    data-bs-toggle="modal" data-bs-target="#feedbackModal_@reservation.reservation_id">
                                                <i class="bi bi-star-fill me-1"></i> Értékelés
                                            </button>

                                            <div class="modal fade" id="feedbackModal_@reservation.reservation_id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow rounded-4">
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold">Szolgáltatás értékelése</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form asp-controller="Profile" asp-action="SubmitFeedback" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reservationId" value="@reservation.reservation_id" />
                                                            <div class="modal-body py-3">
                                                                <p class="small text-muted mb-3">
                                                                    <strong>@sName</strong>
                                                                </p>

                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-bold text-muted">Értékelés (1-5)</label>
                                                                    <select name="rating" class="form-select rounded-3" required>
                                                                        <option value="5" selected>5 - Kiváló</option>
                                                                        <option value="4">4 - Nagyon jó</option>
                                                                        <option value="3">3 - Megfelelő</option>
                                                                        <option value="2">2 - Gyenge</option>
                                                                        <option value="1">1 - Elégedetlen</option>
                                                                    </select>
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-bold text-muted">Szöveges vélemény (opcionális)</label>
                                                                    <textarea name="comment" rows="3" class="form-control rounded-3" placeholder="Oszd meg a tapasztalataidat a szolgáltatásról..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0 pt-0">
                                                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                                                                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">Értékelés beküldése</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="cancelReservationModal" tabindex="-1" aria-labelledby="cancelReservationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="cancelReservationModalLabel">Foglalás lemondása</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Bezárás"></button>
            </div>
            <form asp-controller="Profile" asp-action="CancelReservation" method="post" id="cancelReservationForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reservationId" id="modalCancelReservationId" value="" />
                <div class="modal-body py-4">
                    <p class="text-muted mb-2">Biztosan le szeretnéd mondani a következő foglalásodat?</p>
                    <div class="bg-light p-3 rounded-3 border">
                        <h6 class="fw-bold mb-1 text-dark" id="modalCancelServiceName"></h6>
                        <span class="badge bg-white text-danger border rounded-pill px-3 py-1">
                            <i class="bi bi-clock me-1"></i> <span id="modalCancelDateText"></span>
                        </span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold" id="btnConfirmCancelModal">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="cancelSpinner" role="status" aria-hidden="true"></span>
                        Igen, lemondom
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="editProfileModalLabel">Adatok módosítása</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Profile" asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="email" class="form-label small fw-bold text-muted">Email cím</label>
                        <input type="email" id="email" name="email" class="form-control rounded-3" value="@Model.User.Email" required>
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label small fw-bold text-muted">Telefonszám</label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control rounded-3" value="@Model.User.PhoneNumber">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Mentés</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="changePasswordModalLabel">Jelszó módosítása</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Jelenlegi jelszó</label>
                        <input type="password" name="currentPassword" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Új jelszó</label>
                        <input type="password" name="newPassword" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Új jelszó megerősítése</label>
                        <input type="password" name="confirmPassword" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Módosítás</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!isAdmin)
{
    <div class="modal fade" id="deleteProfileModal" tabindex="-1" aria-labelledby="deleteProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="deleteProfileModalLabel">Fiók törlése</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Profile" asp-action="DeleteProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body py-4">
                        <div class="alert alert-warning small rounded-3 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Figyelem!</strong> A fiók törlése végleges művelet. Az aktív foglalásaid törlődnek, és a fiókodat nem lehet visszaállítani.
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">A törlés jóváhagyásához add meg a jelszavad:</label>
                            <input type="password" name="password" class="form-control rounded-3" placeholder="Jelenlegi jelszó" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Mégsem</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Fiók végleges törlése</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    var cancelReservationModalInstance;

    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('cancelReservationModal');
        if (modalEl) {
            cancelReservationModalInstance = new bootstrap.Modal(modalEl);
        }

        var formEl = document.getElementById('cancelReservationForm');
        if (formEl) {
            formEl.addEventListener('submit', function () {
                var btn = document.getElementById('btnConfirmCancelModal');
                var spinner = document.getElementById('cancelSpinner');
                if (btn && spinner) {
                    btn.disabled = true;
                    spinner.classList.remove('d-none');
                }
            });
        }
    });

    function openCancelReservationModal(reservationId, serviceName, dateText) {
        document.getElementById('modalCancelReservationId').value = reservationId;
        document.getElementById('modalCancelServiceName').innerText = serviceName;
        document.getElementById('modalCancelDateText').innerText = dateText;
        if (cancelReservationModalInstance) {
            cancelReservationModalInstance.show();
        }
    }
</script>